---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import ImgSpendful from '@/assets/spendful.png'
import ImgLF from '@/assets/lfapp.png'
import ImgWager from '@/assets/wager.png'
import ImgGF from '@/assets/gfood.png'
import ImgDanskOff from '@/assets/danskoff.png'
import ImgFMuseum from '@/assets/fmuseum.png'
import ImgImg5 from '@/assets/img5.png'

const list: {
  title: string
  image: ImageMetadata
  links: { label?: string; url: string }[]
}[] = [
  {
    title: 'Spendful',
    image: ImgSpendful,
    links: [
      { label: 'iOS', url: 'https://apps.apple.com/app/id6757114071' }
    ]
  },
  {
    title: 'LongF',
    image: ImgLF,
    links: [
      { label: 'Android', url: 'https://play.google.com/store/apps/details?id=com.vietlong.longf' },
      { label: 'iOS', url: 'https://apps.apple.com/app/id6751319696' }
    ]
  },
  {
    title: 'Wager API',
    image: ImgWager,
    links: [
      { url: 'https://wagerapi.com' }
    ]
  },
  {
    title: 'GrabFood',
    image: ImgGF,
    links: [
      { url: 'https://food.grab.com' }
    ]
  },
  {
    title: 'Dansk Offshore',
    image: ImgDanskOff,
    links: [
      { url: 'https://danskoffshore.dk' }
    ]
  },
  {
    title: 'Frederiksberg Museerne',
    image: ImgFMuseum,
    links: [
      { url: 'https://frederiksbergmuseerne.dk' }
    ]
  },
  {
    title: 'Imagine5',
    image: ImgImg5,
    links: [
      { url: 'https://imagine5.com' }
    ]
  },
]
---

<section class="relative overflow-x-hidden">
  <div class="work-wrapper relative flex-nowrap will-change-transform motion-safe:flex">
    <div class="work-strip relative p-12 flex flex-nowrap gap-20 will-change-transform sm:px-32 xl:gap-32 motion-reduce:flex-wrap motion-reduce:justify-center">
      {list.map(work => (
        <article class="squircle group relative aspect-2/3 rounded-4xl w-[75vw] overflow-hidden p-1 bg-linear-to-br from-black/10 to-black/60 sm:w-[50vw] lg:w-md lg:aspect-square lg:rounded-[3rem] dark:from-white/80 dark:to-white/30">
          {work.image.src && (
            <Image
              src={work.image}
              alt=""
              widths={[300, 600, work.image.width]}
              class="squircle size-full object-cover rounded-[1.8rem] bg-white lg:rounded-[2.75rem]"
            />
          )}
          <div class="squircle absolute inset-1 rounded-[1.8rem] p-6 flex flex-col items-center justify-center gap-1 bg-linear-to-br from-black/30 to-black/60 text-white text-center transition-colors duration-500 lg:from-black/15 lg:rounded-[2.75rem] group-hover:bg-black/50 group-focus-within:bg-black/50 motion-reduce:bg-black/50">
            <div class="text-white text-3xl font-light text-shadow-[1px_1px_black]">{work.title}</div>
            {work.links.length > 0 && (
              <ul class="flex flex-wrap items-center justify-center">
                {work.links.map(link => (
                  <li>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block p-3 font-medium text-shadow-[1px_1px_black] underline-offset-2 hover:underline"
                    >
                      {link.label || new URL(link.url).hostname}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.squircle {
  @supports (corner-shape: squircle) {
    corner-shape: squircle;
    border-radius: 6rem;

    @media (min-width: 40rem) {
      border-radius: 12rem;
    }
  }
}
</style>

<script>
import { gsap } from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'
import { scrollTimeline } from '@/scripts/gsap'

const workWrapper = document.querySelector('.work-wrapper') as HTMLElement
const workStrip = document.querySelector('.work-strip') as HTMLElement
let stripWidth = workStrip.scrollWidth
let scrollLength = stripWidth - window.innerWidth
const matchMedia = gsap.matchMedia('.work-wrapper')

matchMedia.add('(prefers-reduced-motion: no-preference)', () => {
  gsap.fromTo('.work-wrapper article', {
    opacity: 0,
    yPercent: 'random(0, 20)',
    rotate: 'random(-20, 20)',
  }, {
    opacity: 1,
    yPercent: 'random(-10, 10)',
    rotate: 'random(-6, 6)',
    stagger: .2,
    ease: 'none',
    scrollTrigger: {
      trigger: workWrapper,
      start: 'top bottom',
      end: '+=250%',
      scrub: true,
    },
  })

  scrollTimeline.to(workStrip, {
    x: () => -scrollLength,
    ease: 'none',
    scrollTrigger: {
      trigger: workWrapper,
      pin: workWrapper,
      scrub: true,
      start: 'center center',
      end: '+=400%',
      anticipatePin: 2,
      invalidateOnRefresh: true,
    },
  })
  .to(workWrapper, {
    opacity: 0,
    yPercent: -50,
    ease: 'none',
    scrollTrigger: {
      trigger: workWrapper,
      start: 'top top',
      scrub: true,
    },
  })
})

matchMedia.add('(prefers-reduced-motion: reduce)', () => {
  gsap.fromTo('.work-wrapper article', {
    opacity: 0,
  }, {
    opacity: 1,
    yPercent: 0,
    rotate: 0,
    duration: 1,
    stagger: .5,
    scrollTrigger: {
      trigger: workWrapper,
      start: 'top bottom',
    },
  })
})

ScrollTrigger.addEventListener('refreshInit', updateDimensions)

function updateDimensions() {
  stripWidth = workStrip.scrollWidth
  scrollLength = stripWidth - window.innerWidth
}
</script>
