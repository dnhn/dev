---
const projects: {
  title: string
  image: string
  links: {
    label?: string
    url: string
  }[]
}[] = [
  {
    title: 'Spendful',
    image: '',
    links: [
      { label: 'iOS', url: 'https://apps.apple.com/app/id6757114071' }
    ]
  },
  {
    title: 'LongF',
    image: '',
    links: [
      { label: 'Android', url: 'https://play.google.com/store/apps/details?id=com.vietlong.longf' },
      { label: 'iOS', url: 'https://apps.apple.com/app/id6751319696' }
    ]
  },
  {
    title: 'GrabFood',
    image: '',
    links: [
      { url: 'https://food.grab.com' }
    ]
  },
  {
    title: 'Wager API',
    image: '',
    links: [
      { url: 'https://wagerapi.com' }
    ]
  },
  {
    title: 'Image Maker',
    image: '',
    links: [
      { url: 'https://vinamilk.nhan.dev' }
    ]
  },
  {
    title: 'Dansk Offshore',
    image: '',
    links: [
      { url: 'https://danskoffshore.dk' }
    ]
  },
  {
    title: 'Frederiksberg Museerne',
    image: '',
    links: [
      { url: 'https://frederiksbergmuseerne.dk' }
    ]
  },
  {
    title: 'Imagine5',
    image: '',
    links: [
      { url: 'https://imagine5.com' }
    ]
  },
]
---

<section>
  <div class="work-wrapper flex will-change-transform">
    <div class="work-strip px-12 flex gap-12 will-change-transform sm:px-32 sm:gap-16 lg:gap-32">
      {projects.map(project => (
        <article class="squircle group relative aspect-2/3 rounded-4xl w-[75vw] overflow-hidden p-1 bg-linear-to-br from-black/10 to-black/60 sm:w-96 md:aspect-square lg:rounded-[3rem] dark:from-white/80 dark:to-white/30">
          {project.image && (
            <img
              src={project.image}
              alt=""
              loading="lazy"
              class="squircle size-full object-cover rounded-[1.8rem] bg-white lg:rounded-[2.75rem]"
            />
          )}
          <div class="squircle absolute inset-1 rounded-[1.8rem] p-6 flex flex-col items-center justify-center gap-1 bg-linear-to-br from-black/30 to-black/60 text-white text-center transition-colors duration-500 lg:from-black/15 lg:rounded-[2.75rem] group-hover:bg-black/50 group-focus-within:bg-black/50">
            <div class="text-white text-2xl font-light text-shadow-1px">{project.title}</div>
            {project.links.length > 0 && (
              <ul class="flex flex-wrap items-center justify-center">
                {project.links.map(link => (
                  <li>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block p-3 text-sm font-medium text-shadow-1px underline-offset-2 hover:underline"
                    >
                      {link.label || new URL(link.url).hostname}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.text-shadow-1px {
  text-shadow: 1px 1px black;
}

.squircle {
  @supports (corner-shape: squircle) {
    corner-shape: squircle;
    border-radius: 6rem;

    @media (min-width: 48rem) {
      border-radius: 12rem;
    }
  }
}
</style>

<script>
import { ScrollTrigger } from 'gsap/ScrollTrigger'
import { scrollTimeline } from '@/src/scripts/gsap';

const workWrapper = document.querySelector('.work-wrapper') as HTMLElement
const workStrip = document.querySelector('.work-strip') as HTMLElement

let stripWidth = workStrip.scrollWidth
let scrollLength = stripWidth - window.innerWidth

scrollTimeline.from('.work-wrapper article', {
  opacity: 0,
  xPercent: 200,
  stagger: .05,
  scrollTrigger: {
    trigger: workWrapper,
    start: 'top bottom',
    scrub: true,
  }
})
.to(workStrip, {
  x: -scrollLength,
  ease: 'none',
  scrollTrigger: {
    trigger: workWrapper,
    pin: workWrapper,
    scrub: true,
    start: 'center center',
    end: `+=${stripWidth * .75}`,
    anticipatePin: 2,
    invalidateOnRefresh: true,
  }
})
.to('.work-wrapper', {
  opacity: 0,
  scrollTrigger: {
    trigger: workWrapper,
    start: 'top top',
    scrub: true,
  }
})

ScrollTrigger.addEventListener('refresh', updateDimensions)

function updateDimensions() {
  stripWidth = workStrip.scrollWidth
  scrollLength = stripWidth - window.innerWidth
}
</script>
