---
const projects = [
  {
    title: "Project Alpha",
    image: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=400&h=400&fit=crop",
    url: "https://example.com/alpha"
  },
  {
    title: "Project Beta",
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=400&h=400&fit=crop",
    url: "https://example.com/beta"
  },
  {
    title: "Project Gamma",
    image: "https://images.unsplash.com/photo-1547658719-da2b51169166?w=400&h=400&fit=crop"
  },
  {
    title: "Project Delta",
    image: "https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=400&h=400&fit=crop",
    url: "https://example.com/delta"
  },
  {
    title: "Project Epsilon",
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=400&h=400&fit=crop"
  },
  {
    title: "Project Zeta",
    image: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=400&h=400&fit=crop",
    url: "https://example.com/zeta"
  },
  {
    title: "Project Eta",
    image: "https://images.unsplash.com/photo-1547658719-da2b51169166?w=400&h=400&fit=crop"
  },
  {
    title: "Project Theta",
    image: "https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=400&h=400&fit=crop",
    url: "https://example.com/theta"
  },
  {
    title: "Project Iota",
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=400&h=400&fit=crop"
  },
  {
    title: "Project Kappa",
    image: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=400&h=400&fit=crop",
    url: "https://example.com/kappa"
  },
]
---

<section>
  <div class="work-wrapper flex will-change-transform">
    <div class="work-strip px-12 flex gap-12 will-change-transform sm:px-32 sm:gap-16 lg:gap-32">
      {projects.map(project => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="squircle group relative aspect-2/3 rounded-4xl w-[75vw] overflow-hidden p-1 bg-linear-to-br from-black/10 to-black/60 sm:w-96 md:aspect-square lg:rounded-[3rem] dark:from-white/80 dark:to-white/30"
        >
          <img
            src={project.image}
            alt={project.title}
            loading="lazy"
            class="squircle size-full rounded-[1.8rem] bg-white lg:rounded-[2.75rem]"
          />
          <div class="squircle absolute inset-1 rounded-[1.8rem] flex items-center justify-center bg-linear-to-br from-black/30 to-black/60 text-white text-center transition-colors duration-500 lg:from-black/15 lg:rounded-[2.75rem] group-hover:bg-black/50 group-focus-visible:bg-black/50">
            <h3 class="text-white text-2xl font-semibold p-6">{project.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.squircle {
  @supports (corner-shape: squircle) {
    corner-shape: squircle;
    border-radius: 6rem;

    @media (min-width: 48rem) {
      border-radius: 12rem;
    }
  }
}
</style>

<script>
import { ScrollTrigger } from 'gsap/ScrollTrigger'
import { scrollTimeline } from '@/src/scripts/gsap';

const workWrapper = document.querySelector('.work-wrapper') as HTMLElement
const workStrip = document.querySelector('.work-strip') as HTMLElement

let stripWidth = workStrip.scrollWidth
let scrollLength = stripWidth - window.innerWidth

scrollTimeline.to(workStrip, {
  x: -scrollLength,
  ease: 'none',
  scrollTrigger: {
    trigger: workWrapper,
    pin: workWrapper,
    scrub: true,
    start: 'center center',
    end: `+=${stripWidth * 3}`,
    anticipatePin: 2,
    invalidateOnRefresh: true,
  }
})

ScrollTrigger.addEventListener('refresh', updateDimensions)

function updateDimensions() {
  stripWidth = workStrip.scrollWidth
  scrollLength = stripWidth - window.innerWidth
}
</script>
