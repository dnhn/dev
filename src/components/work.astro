---
import { Image } from 'astro:assets'
import { WORKS } from '@/scripts/data'
import FileName from '@/components/file-name.astro'
---

<section class="work relative">
  <h2 class="sr-only">My Work</h2>
  <FileName path="src/components/work.astro" label="work.astro" class="top-4 left-1/2 -translate-x-1/2" />
  {WORKS.map(work => (
    <article class="group relative h-svh overflow-hidden">
      {work.image.src && (
        <Image
          src={work.image}
          width={work.image.width}
          alt=""
          densities={[1, 2, 3]}
          quality="high"
          data-speed=".5"
          class="size-full object-cover bg-white"
        />
      )}
      <div class="absolute inset-0 p-6 flex items-center justify-center bg-linear-to-br from-black/50 to-black text-white text-center">
        <div data-speed=".75">
          <h3 class="text-white text-3xl font-light text-shadow-[1px_1px_black] sm:text-5xl 2xl:text-7xl">{work.title}</h3>
          {work.links.length > 0 && (
            <ul class="mt-2 flex flex-wrap items-center justify-center sm:mt-6 2xl:mt-8">
              {work.links.map(link => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block p-3 text-shadow-[1px_1px_black] underline-offset-2 hover:underline sm:p-4 sm:text-2xl 2xl:text-4xl 2xl:underline-offset-4"
                  >
                    {link.label || new URL(link.url).hostname}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </article>
  ))}
</section>
