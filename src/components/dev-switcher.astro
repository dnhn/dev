---
const props = Astro.props
---

<div class="group dev-switcher fixed left-1/2 bottom-2 -translate-x-1/2 text-center sm:bottom-6">
  <div id="dev-mode-label" class="mb-1 opacity-0 font-mono text-xs font-bold uppercase group-hover:opacity-100">
    Dev Mode:
    <span class="label-off">off</span>
    <span class="label-on hidden">on</span>
  </div>
  <button
    type="button"
    role="switch"
    aria-labelledby="dev-mode-label"
    aria-checked="false"
    class="opacity-30 rounded-xl p-1 border-4 border-neutral-900 duration-200 group-hover:opacity-100 focus:opacity-100 dark:border-orange-50"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" {...props} class="size-8">
      <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" class="transition-colors" d="M4.78001 4.97002C4.92046 5.11065 4.99935 5.30127 4.99935 5.50002C4.99935 5.69878 4.92046 5.8894 4.78001 6.03002L2.81001 8.00002L4.78001 9.97002C4.8537 10.0387 4.9128 10.1215 4.95379 10.2135C4.99478 10.3055 5.01683 10.4048 5.0186 10.5055C5.02038 10.6062 5.00186 10.7062 4.96413 10.7996C4.92641 10.893 4.87027 10.9778 4.79905 11.0491C4.72783 11.1203 4.643 11.1764 4.54961 11.2141C4.45622 11.2519 4.35619 11.2704 4.25549 11.2686C4.15479 11.2668 4.05547 11.2448 3.96347 11.2038C3.87147 11.1628 3.78867 11.1037 3.72001 11.03L1.22001 8.53002C1.07956 8.3894 1.00067 8.19877 1.00067 8.00002C1.00067 7.80127 1.07956 7.61065 1.22001 7.47002L3.72001 4.97002C3.86064 4.82957 4.05126 4.75068 4.25001 4.75068C4.44876 4.75068 4.63939 4.82957 4.78001 4.97002ZM11.22 4.97002C11.0796 5.11065 11.0007 5.30127 11.0007 5.50002C11.0007 5.69878 11.0796 5.8894 11.22 6.03002L13.19 8.00002L11.22 9.97002C11.1463 10.0387 11.0872 10.1215 11.0462 10.2135C11.0052 10.3055 10.9832 10.4048 10.9814 10.5055C10.9796 10.6062 10.9982 10.7062 11.0359 10.7996C11.0736 10.893 11.1298 10.9778 11.201 11.0491C11.2722 11.1203 11.357 11.1764 11.4504 11.2141C11.5438 11.2519 11.6438 11.2704 11.7445 11.2686C11.8452 11.2668 11.9446 11.2448 12.0365 11.2038C12.1285 11.1628 12.2113 11.1037 12.28 11.03L14.78 8.53002C14.9205 8.3894 14.9994 8.19877 14.9994 8.00002C14.9994 7.80127 14.9205 7.61065 14.78 7.47002L12.28 4.97002C12.1394 4.82957 11.9488 4.75068 11.75 4.75068C11.5513 4.75068 11.3606 4.82957 11.22 4.97002ZM8.85601 2.00802C9.05275 2.03625 9.23023 2.14142 9.34948 2.30042C9.46873 2.45942 9.52 2.65925 9.49201 2.85602L7.99201 13.356C7.95776 13.5473 7.8506 13.7178 7.6931 13.8317C7.5356 13.9455 7.34007 13.9938 7.14769 13.9663C6.95531 13.9388 6.78111 13.8377 6.66179 13.6843C6.54246 13.531 6.48733 13.3373 6.50801 13.144L8.00801 2.64402C8.03624 2.44729 8.14141 2.2698 8.30041 2.15055C8.45941 2.0313 8.65924 1.98004 8.85601 2.00802Z"/>
    </svg>
  </button>
</div>

<style is:global>
.dev-switcher {
  .label-off {
    .dev & {
      display: none;
    }
  }

  .label-on {
    .dev & {
      display: initial;
    }
  }

  button {
    transition-property: background-color, scale;

    &:active {
      scale: .9;
    }

    .dev & {
      background-color: black;
      opacity: 1;

      path {
        fill: white;
      }
    }
  }
}

@media (prefers-color-scheme: dark) {
  .dev-switcher {
    .dev & {
      button {
        background-color: white;

        path {
          fill: black;
        }
      }
    }
  }
}
</style>

<script>
import { gsap } from 'gsap';

const isDev = new URLSearchParams(window.location.search).get('dev') !== null
if (isDev) document.body.classList.add('dev')

const switcher = document.querySelector('.dev-switcher button') as HTMLButtonElement
const switcherPath = switcher.querySelector('path')
// https://icon-sets.iconify.design/heroicons/code-bracket-16-solid/
const startPath = 'M4.78001 4.97002C4.92046 5.11065 4.99935 5.30127 4.99935 5.50002C4.99935 5.69878 4.92046 5.8894 4.78001 6.03002L2.81001 8.00002L4.78001 9.97002C4.8537 10.0387 4.9128 10.1215 4.95379 10.2135C4.99478 10.3055 5.01683 10.4048 5.0186 10.5055C5.02038 10.6062 5.00186 10.7062 4.96413 10.7996C4.92641 10.893 4.87027 10.9778 4.79905 11.0491C4.72783 11.1203 4.643 11.1764 4.54961 11.2141C4.45622 11.2519 4.35619 11.2704 4.25549 11.2686C4.15479 11.2668 4.05547 11.2448 3.96347 11.2038C3.87147 11.1628 3.78867 11.1037 3.72001 11.03L1.22001 8.53002C1.07956 8.3894 1.00067 8.19877 1.00067 8.00002C1.00067 7.80127 1.07956 7.61065 1.22001 7.47002L3.72001 4.97002C3.86064 4.82957 4.05126 4.75068 4.25001 4.75068C4.44876 4.75068 4.63939 4.82957 4.78001 4.97002ZM11.22 4.97002C11.0796 5.11065 11.0007 5.30127 11.0007 5.50002C11.0007 5.69878 11.0796 5.8894 11.22 6.03002L13.19 8.00002L11.22 9.97002C11.1463 10.0387 11.0872 10.1215 11.0462 10.2135C11.0052 10.3055 10.9832 10.4048 10.9814 10.5055C10.9796 10.6062 10.9982 10.7062 11.0359 10.7996C11.0736 10.893 11.1298 10.9778 11.201 11.0491C11.2722 11.1203 11.357 11.1764 11.4504 11.2141C11.5438 11.2519 11.6438 11.2704 11.7445 11.2686C11.8452 11.2668 11.9446 11.2448 12.0365 11.2038C12.1285 11.1628 12.2113 11.1037 12.28 11.03L14.78 8.53002C14.9205 8.3894 14.9994 8.19877 14.9994 8.00002C14.9994 7.80127 14.9205 7.61065 14.78 7.47002L12.28 4.97002C12.1394 4.82957 11.9488 4.75068 11.75 4.75068C11.5513 4.75068 11.3606 4.82957 11.22 4.97002ZM8.85601 2.00802C9.05275 2.03625 9.23023 2.14142 9.34948 2.30042C9.46873 2.45942 9.52 2.65925 9.49201 2.85602L7.99201 13.356C7.95776 13.5473 7.8506 13.7178 7.6931 13.8317C7.5356 13.9455 7.34007 13.9938 7.14769 13.9663C6.95531 13.9388 6.78111 13.8377 6.66179 13.6843C6.54246 13.531 6.48733 13.3373 6.50801 13.144L8.00801 2.64402C8.03624 2.44729 8.14141 2.2698 8.30041 2.15055C8.45941 2.0313 8.65924 1.98004 8.85601 2.00802Z'
// https://icon-sets.iconify.design/iconamoon/cursor-fill/
const endPath = 'M2.92001 2.05003C2.79828 1.99994 2.66445 1.98701 2.53538 2.01287C2.40631 2.03872 2.28779 2.10221 2.19475 2.19532C2.1017 2.28843 2.03831 2.40701 2.01255 2.53609C1.9868 2.66518 1.99983 2.799 2.05001 2.9207L6.71668 14.254C6.76666 14.3755 6.85138 14.4794 6.96022 14.5529C7.06905 14.6263 7.19716 14.666 7.32846 14.6669C7.45977 14.6679 7.58842 14.63 7.69828 14.5581C7.80815 14.4862 7.89432 14.3834 7.94601 14.2627L9.73601 10.086C9.80344 9.92877 9.92875 9.80346 10.086 9.73603L14.2627 7.94603C14.3834 7.89434 14.4861 7.80816 14.5581 7.6983C14.63 7.58844 14.6678 7.45979 14.6669 7.32848C14.666 7.19718 14.6263 7.06907 14.5528 6.96024C14.4794 6.8514 14.3754 6.76667 14.254 6.7167L2.92001 2.05003Z'

const tl = gsap.timeline({
  paused: isDev,
  onComplete: function () {
    document.body.classList.remove('dev')
    switcher.setAttribute('aria-checked', 'false')
    const url = new URL(window.location.toString())
    url.searchParams.delete('dev')
    window.history.replaceState('', '', url)
  },
  onReverseComplete: function () {
    document.body.classList.add('dev')
    switcher.setAttribute('aria-checked', 'true')
    const url = new URL(window.location.toString())
    url.searchParams.set('dev', 'true')
    window.history.replaceState('', '', url)
  },
})
.to(switcherPath, {
  morphSVG: startPath,
  duration: .2,
  ease: 'power2.in',
})
.to(switcherPath, {
  morphSVG: endPath,
  duration: .2,
  ease: 'power2.out',
})

switcher.addEventListener('click', () => {
  if (tl.paused()) {
    tl.play()
  } else {
    tl.reversed(!tl.reversed())
  }
})
</script>
