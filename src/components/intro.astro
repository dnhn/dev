---
import SloganCircle from '@/components/slogan-circle.svelte'
import FileName from '@/components/file-name.astro'

const content = [
  'A front-end developer focused on building thoughtful, user-centric products and making the Web a better place.',
  'With expertise in Next.js, Astro, and React Native, I craft accessible interfaces that balance aesthetic with meticulous attention to detail.',
  'I believe delightful user experience comes from caring about every interaction.',
]
---

<SloganCircle client:only="svelte" position={0} />
<SloganCircle client:only="svelte" position={1} />

<section class="intro min-h-svh py-16 items-center justify-center md:py-32 lg:py-48 lg:flex">
  <FileName path="src/components/intro.astro" label="intro.astro" class="top-4 left-1/2 -translate-x-1/2" />
  <div class="container gap-12 lg:flex xl:gap-16">
    <div class="flex-1/3">
      <h1 data-speed="clamp(1.8)" data-lag=".25" class="text-5xl leading-tight font-light sm:text-6xl lg:text-right lg:text-7xl xl:text-8xl">
        <span class="sr-only">Hey, I’m</span>
        <span class="split" style="color:transparent">Hey, I’m</span><br class="max-lg:hidden" />
        <button type="button" onclick="playNameSound()" class="name relative cursor-crosshair font-bold">
          <span class="sr-only">Nhan!</span>
          <span aria-hidden="true" class="bg bg-linear-45 from-cyan-300 via-indigo-500  to-blue-300 bg-clip-text text-transparent dark:from-lime-700 dark:via-yellow-300 dark:to-emerald-800" style="background:none">
            Nhan!
          </span>
        </button>
      </h1>
    </div>
    <div class="paragraphs flex-2/3 space-y-6 max-lg:mt-8 xl:space-y-8" style="color:transparent">
      {content.map((text, i) => (
        <p class="sr-only">{text}</p>
        <p data-speed={`clamp(${1.5 - i * 0.1})`} data-lag=".5" class="paragraph max-w-[50ch] text-xl leading-relaxed sm:text-2xl xl:text-3xl">
          {text}
        </p>
      ))}
    </div>
  </div>
</section>

<style is:global>
@property --bg-x {
  syntax: '<percentage>';
  inherits: false;
  initial-value: 0%;
}

.intro .bg {
  background-size: 200% 200%;
  background-position: var(--bg-x) 50%;
  animation: bgShift 5s ease infinite;
}

@keyframes bgShift {
  0% { --bg-x: 0%; }
  50% { --bg-x: 100%; }
  100% { --bg-x: 0%; }
}
</style>

<script>
import { gsap } from 'gsap'
import '@/scripts/gsap'
import { SplitText } from 'gsap/SplitText'

const splash = document.getElementById('splash') as HTMLElement
const splashSvg = splash.querySelector('svg') as SVGSVGElement
const splashPath = splashSvg.querySelector('path') as SVGPathElement
const splashTl = gsap.timeline({ paused: true })
.fromTo(splashSvg, {
  scale: 0,
}, {
  opacity: 1,
  scale: 1,
  duration: .8,
  ease: 'sine.out',
})
.from(splashPath, {
  drawSVG: 0,
  duration: 1.2,
  ease: 'sine.inOut',
}, '<')
.to(splash, {
  autoAlpha: 0,
  duration: .2,
  ease: 'none',
}, '+=.3')
const split = SplitText.create('.intro h1 .split', {
  type: 'words, chars',
  autoSplit: true,
  aria: 'hidden',
})
const splitP = SplitText.create('.intro .paragraph', {
  type: 'lines, words, chars',
  mask: 'lines',
  autoSplit: true,
  aria: 'hidden',
})

gsap.set(['.intro .split', '.intro .paragraphs'], { color: '' })
gsap.set('.intro .bg', { background: '' })

const matchMedia = gsap.matchMedia('.intro')

matchMedia.add('(prefers-reduced-motion: no-preference)', function () {
  gsap.timeline()
  .add(splashTl.play(0))
  .from(split.chars, {
    display: 'none',
    delay: .2,
    stagger: .2,
  })
  .from('.intro .name', {
    opacity: 0,
    left: -50,
  }, '>-.25')
  .from(splitP.chars, {
    yPercent: 100,
    duration: 1,
    stagger: .008,
  }, '>-.25')
})
.add('(prefers-reduced-motion: reduce)', function () {
  gsap.timeline()
  .add(splashTl.play(0))
  .from(split.chars, {
    opacity: 0,
    stagger: .2,
  })
  .from('.intro .name', {
    opacity: 0,
  })
  .from(splitP.lines, {
    opacity: 0,
    duration: 1,
    stagger: .5,
  })
})

document.querySelector('.intro .name')!.addEventListener('click', function () {
  gsap.fromTo('.intro .name', {
    scaleY: 1,
    scaleX: 1,
    fontWeight: 700,
  }, {
    scaleY: 'random(1.1, 1.2)',
    scaleX: 'random(1.1, 1.5)',
    fontWeight: 100,
    duration: .2,
    ease: 'sine.out',
    yoyo: true,
    repeat: 1,
  })
})
</script>

<script is:inline>
let nameAudio

function playNameSound() {
  if (!nameAudio) nameAudio = new Audio('/sounds/241809_4404552-lq.mp3')
  nameAudio.currentTime = 0
  nameAudio.play()
}
</script>
