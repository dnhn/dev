---
import SloganCircle from '@/components/slogan-circle.svelte'

const content = [
  'A front-end developer focused on building thoughtful, user-centric products and making the Web a better place.',
  'With expertise in Next.js, Astro, and React Native, I craft accessible interfaces that balance aesthetic with meticulous attention to detail.',
  'I believe delightful user experience comes from caring about every interaction.',
]
---

<SloganCircle client:only="svelte" position={0} />
<SloganCircle client:only="svelte" position={1} />

<section class="intro min-h-svh py-16 items-center justify-center md:py-32 lg:py-48 lg:flex">
  <div class="container gap-12 lg:flex xl:gap-16">
    <div class="flex-1/3">
      <h1 data-speed="clamp(1.8)" class="text-5xl leading-tight font-light sm:text-6xl lg:text-right lg:text-7xl xl:text-8xl" style="visibility:hidden">
        <span class="sr-only">Hey, I’m</span>
        <span class="split">Hey, I’m</span><br class="max-lg:hidden" />
        <button type="button" onclick="playSound" class="name relative cursor-crosshair font-bold">
          <span class="sr-only">Nhan!</span>
          <span aria-hidden="true" class="bg bg-linear-45 from-cyan-300 via-indigo-500  to-blue-300 bg-clip-text text-transparent dark:from-lime-700 dark:via-yellow-300 dark:to-emerald-800">
            Nhan!
          </span>
        </button>
      </h1>
    </div>
    <div class="flex-2/3 space-y-6 max-lg:mt-8 xl:space-y-8">
      {content.map((text, i) => (
        <p class="sr-only">{text}</p>
        <p data-speed={`clamp(${1.5 - i * 0.1})`} class="paragraph max-w-[50ch] text-xl leading-relaxed sm:text-2xl xl:text-3xl" style="visibility:hidden">
          {text}
        </p>
      ))}
    </div>
  </div>
</section>

<style>
.bg {
  background-size: 200% 200%;
  animation: gradientShift 5s ease infinite;
}

@keyframes gradientShift {
  0% { background-position: 0 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
</style>

<script>
import { gsap } from 'gsap'
import '@/scripts/gsap'
import { SplitText } from 'gsap/SplitText'

const splash = document.getElementById('splash') as HTMLElement
const splashSvg = splash.querySelector('svg') as SVGSVGElement
const splashPath = splashSvg.querySelector('path') as SVGPathElement
const splashTl = gsap.timeline({ paused: true })
.fromTo(splashSvg, {
  width: 0,
  height: 0,
}, {
  width: '25vw',
  height: '25svh',
  duration: .8,
  ease: 'sine.out',
})
.from(splashPath, {
  drawSVG: 0,
  duration: 1.2,
  ease: 'sine.inOut',
}, '<')
.to(splash, {
  autoAlpha: 0,
  duration: .2,
  ease: 'none',
}, '+=.3')
const split = SplitText.create('.intro h1 .split', {
  type: 'words, chars',
  autoSplit: true,
  aria: 'hidden',
})
const splitP = SplitText.create('.intro .paragraph', {
  type: 'lines, words, chars',
  autoSplit: true,
  aria: 'hidden',
})

gsap.set(['.intro h1', '.intro .paragraph', splashSvg], { autoAlpha: 1 })

const matchMedia = gsap.matchMedia('.intro')

matchMedia.add('(prefers-reduced-motion: no-preference)', () => {
  gsap.timeline()
  .add(splashTl.play(0))
  .from(split.chars, {
    display: 'none',
    delay: .2,
    stagger: .2,
  })
  .from('.intro h1 .name', {
    opacity: 0,
    left: -50,
  })
  .from(splitP.chars, {
    opacity: 0,
    rotateX: 180,
    duration: .5,
    stagger: .02,
    ease: 'none',
  })
})
.add('(prefers-reduced-motion: reduce)', () => {
  gsap.timeline()
  .add(splashTl.play(0))
  .from(split.chars, {
    opacity: 0,
    stagger: .2,
  })
  .from('.intro h1 .name', {
    opacity: 0,
  })
  .from(splitP.lines, {
    opacity: 0,
    duration: 1,
    stagger: .5,
  })
})

// https://freesound.org/s/241809
const nameAudio = new Audio('/sounds/241809_4404552-lq.mp3')

document.querySelector('.intro h1 .name')!.addEventListener('click', function () {
  nameAudio.currentTime = 0
  nameAudio.play()

  gsap.fromTo('.intro h1 .name', {
    scaleY: 1,
    scaleX: 1,
    fontWeight: 700,
  }, {
    scaleY: 1.2,
    scaleX: 1.5,
    fontWeight: 100,
    duration: .2,
    ease: 'sine.out',
    yoyo: true,
    repeat: 1,
  })
})
</script>
