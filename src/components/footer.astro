---
import { Image } from 'astro:assets'
import NhanDev from '@/components/nhan-dev.astro'
import SloganCircle from '@/components/slogan-circle.svelte'
import AtSymbol from '@/components/icons/at-symbol.astro'
import GitHubIcon from '@/components/icons/github-icon.astro'
import LinkedInIcon from '@/components/icons/linkedin-icon.astro'
import SunRising from '@/components/icons/sun-rising.astro'
import FileName from '@/components/file-name.astro'
---

<footer class="relative min-h-svh">
  <FileName path="src/components/footer.astro" label="footer.astro" class="top-4 left-1/2 -translate-x-1/2" />
  <div class="container py-16 md:py-24 lg:py-36">
    <NhanDev />
    <div data-lag=".125" class="mt-20 items-end justify-between gap-6 md:mt-32 md:flex">
      <p class="text-xl md:max-w-[14ch] md:text-4xl/snug">
        Make the <a
          href="https://home.cern/science/computing/birth-web"
          target="_blank"
          rel="noopener noreferrer"
          class="underline-offset-2 max-lg:underline hover:underline"
        >Web</a> a better place
        <button type="button" aria-label="Shiny" onclick="playSunSound()" class="group sun inline align-middle size-8 text-yellow-400 md:size-12 dark:text-[yellow]">
          <SunRising class="size-full transition-[scale] group-active:scale-150" />
        </button>
      </p>
      <button type="button" onclick="playHeySound()" onmouseenter="playHeySound()" class="hey group relative inline-block text-xl cursor-grab max-md:mt-4 md:text-4xl">
        <span class="sr-only">Contact me:</span>
        <Image
          src="/raised-hand.svg"
          alt="Raised hand"
          width={64}
          height={64}
          aria-hidden="true"
          class="absolute bottom-0 max-md:left-full md:right-full ml-2 mr-1 opacity-0 size-8 transition-[opacity,rotate] origin-[40%_70%] md:size-12 lg:group-hover:opacity-100 lg:group-focus:opacity-100 lg:group-hover:-rotate-20 lg:group-focus:-rotate-20 group-active:opacity-100 group-active:-rotate-20"
        />hey<AtSymbol aria-label="at" class="inline size-5 md:size-8" />nhan.dev
      </button>
    </div>
    <div class="mt-30 justify-between items-end gap-8 md:mt-48 md:flex">
      <ul data-lag=".25" class="flex items-center flex-wrap gap-4 max-md:justify-end">
        <li class="size-11">
          <a
            href="https://github.com/dnhn"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block"
          >
            <GitHubIcon aria-label="GitHub" class="size-11" />
          </a>
        </li>
        <li class="size-11">
          <a
            href="https://linkedin.com/in/dnhn"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block"
          >
            <LinkedInIcon aria-label="LinkedIn" class="size-11" />
          </a>
        </li>
      </ul>
      <p data-lag=".5" class="text-sm max-md:mt-6 max-md:text-right md:text-lg">
        messing with the Web since <a
          href="https://en.wikipedia.org/wiki/2008"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold italic underline-offset-2 max-lg:underline hover:underline"
        >2008</a>.
      </p>
    </div>
  </div>
</footer>

<SloganCircle client:only="svelte" position={2} />
<SloganCircle client:only="svelte" position={3} />

<script is:inline>
let heyAudio, sunAudio

function playHeySound() {
  if (!heyAudio) heyAudio = new Audio('/sounds/88401_950462-lq.mp3')
  heyAudio.currentTime = 0
  heyAudio.play()
}

function playSunSound() {
  if (!sunAudio) sunAudio = new Audio('/sounds/810183_17437502-lq.mp3')
  sunAudio.currentTime = 0
  sunAudio.play()
}
</script>
