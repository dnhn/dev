---
import AtSymbol from '@/components/icons/at-symbol.astro'
import GitHubIcon from '@/components/icons/github-icon.astro'
import LinkedInIcon from '@/components/icons/linkedin-icon.astro'
import SunRising from '@/components/icons/sun-rising.astro'
---

<footer class="text-right text-xl">
  <div class="container py-8 pb-16 lg:pt-16 lg:pb-24">
    <div>
      <div tabindex={0} class="group relative inline-block mb-2 font-bold">
        <span class="sr-only">Contact me:</span>
        <img
          src="/raised-hand.svg"
          alt=""
          class="absolute bottom-0 right-full mr-1 opacity-0 size-8 transition-[opacity,rotate] origin-[40%_70%] group-hover:opacity-100 group-focus:opacity-100 group-hover:-rotate-20 group-focus:-rotate-20"
        />hey<AtSymbol aria-label="at" class="inline size-5" />nhan.dev
      </div>
      <p class="text-lg">Make the Web a better place <SunRising class="inline-block size-8 text-yellow-400 dark:text-[yellow]" /></p>
    </div>
    <ul class="mt-6 flex items-center justify-end flex-wrap gap-4">
      <li>
        <a
          href="https://github.com/dnhn"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block"
        >
          <GitHubIcon aria-label="GitHub" class="size-11" />
        </a>
      </li>
      <li>
        <a
          href="https://linkedin.com/in/dnhn"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block"
        >
          <LinkedInIcon aria-label="LinkedIn" class="size-11" />
        </a>
      </li>
    </ul>
    <p class="mt-16 text-base">
      been fooling around since
      <a
        href="https://en.wikipedia.org/wiki/2008"
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold italic"
      >2008</a>.
    </p>
  </div>
</footer>
