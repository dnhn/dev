---
import NhanDev from '@/components/nhan-dev.astro'
import SloganCircle from 'src/components/slogan-circle.svelte'
import AtSymbol from '@/components/icons/at-symbol.astro'
import GitHubIcon from '@/components/icons/github-icon.astro'
import LinkedInIcon from '@/components/icons/linkedin-icon.astro'
import SunRising from '@/components/icons/sun-rising.astro'
---

<SloganCircle client:only="svelte" position={2} />
<SloganCircle client:only="svelte" position={3} />

<footer class="min-h-svh">
  <div class="container py-16 md:py-24 lg:py-36">
    <button type="button" aria-label="The drawing, click to replay" class="nhan-dev group relative cursor-none">
      <NhanDev class="w-full h-auto aspect-[3.75]" />
      <span class="indicator absolute top-0 left-0 opacity-0 size-20 pointer-events-none transition-opacity group-hover:opacity-100">
        <img src="/sparkles.svg" alt="" class="size-full" />
      </span>
    </button>
    <div data-lag=".125" class="mt-20 items-end justify-between gap-6 md:mt-32 md:flex">
      <p class="text-xl md:max-w-[14ch] md:text-4xl/snug">
        Make the
        <a
          href="https://home.cern/science/computing/birth-web"
          target="_blank"
          rel="noopener noreferrer"
          class="underline-offset-2 max-lg:underline hover:underline"
        >Web</a>
        a better place <SunRising class="inline-block size-8 text-yellow-400 md:size-12 dark:text-[yellow]" />
      </p>
      <div tabindex={0} class="group relative inline-block text-xl cursor-grab max-md:mt-4 md:text-4xl">
        <span class="sr-only">Contact me:</span>
        <img
          src="/raised-hand.svg"
          alt=""
          width={64}
          height={64}
          aria-hidden="true"
          loading="lazy"
          class="absolute bottom-0 max-md:left-full md:right-full ml-2 mr-1 opacity-0 size-8 transition-[opacity,rotate] origin-[40%_70%] md:size-12 group-hover:opacity-100 group-focus:opacity-100 group-hover:-rotate-20 group-focus:-rotate-20"
        />hey<AtSymbol aria-label="at" class="inline size-5 md:size-8" />nhan.dev
      </div>
    </div>
    <div class="mt-30 justify-between items-end gap-8 md:mt-48 md:flex">
      <ul data-lag=".25" class="flex items-center flex-wrap gap-4 max-md:justify-end">
        <li class="size-11">
          <a
            href="https://github.com/dnhn"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block"
          >
            <GitHubIcon aria-label="GitHub" class="size-11" />
          </a>
        </li>
        <li class="size-11">
          <a
            href="https://linkedin.com/in/dnhn"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block"
          >
            <LinkedInIcon aria-label="LinkedIn" class="size-11" />
          </a>
        </li>
      </ul>
      <p data-lag=".5" class="text-sm max-md:mt-6 max-md:text-right md:text-lg">
        messing with the Web since
        <a
          href="https://en.wikipedia.org/wiki/2008"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold italic underline-offset-2 max-lg:underline hover:underline"
        >2008</a>.
      </p>
    </div>
  </div>
</footer>

<script>
import { gsap } from 'gsap'

const nd = document.querySelector('.nhan-dev') as HTMLElement
const indicator = nd.querySelector('.indicator') as HTMLElement
const paths = nd.querySelectorAll('path')
const draw = gsap.timeline({
  defaults: { drawSVG: 0, ease: 'none' },
  scrollTrigger: {
    trigger: 'footer',
    start: 'top center',
  },
})
.from(paths[0], { duration: 3 })
.from(paths[1], { duration: .75 })
.from(paths[2], { duration: 1.25 })
const drawBlank = gsap.timeline({
  defaults: {
    drawSVG: '100% 100%',
    ease: 'none',
  },
  paused: true,
})
.to(paths[0], { duration: 1.5 })
.to(paths[1], { duration: .375 })
.to(paths[2], { duration: .625 })

gsap.set(indicator, { xPercent: -50, yPercent: -50 })

nd.addEventListener('click', function () {
  if (draw.isActive() || drawBlank.isActive()) return
  if (draw.progress() === 1) {
    drawBlank.play(0)
    .eventCallback('onComplete', function () {
      draw.restart()
    })
  }
})

const xTo = gsap.quickTo(indicator, 'x', {duration: .6, ease: 'power4'})
const yTo = gsap.quickTo(indicator, 'y', {duration: .6, ease: 'power4'})

window.addEventListener('mousemove', function (e) {
  const { left, top } = nd.getBoundingClientRect()

  xTo(e.clientX - left)
  yTo(e.clientY - top)
})
</script>
