---
import LinkedInIcon from '@/components/icons/linkedin-icon.astro'
import GitHubIcon from '@/components/icons/github-icon.astro'
import AtSymbol from '@/components/icons/at-symbol.astro'
---

<footer class="w-screen h-lvh text-right text-xl">
  <div class="container py-8 pb-16 lg:pt-16 lg:pb-24">
    <div>
      <h3 class="group inline-block mb-2 font-bold">
        <span class="sr-only">Contact me at:</span>
        <span class="opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 cursor-grab" aria-hidden="true">👋🏼&nbsp;</span>
        <span class="opacity-50 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity sm:opacity-20 cursor-grab">hey<AtSymbol aria-label="at" class="inline size-5" /></span><a href="https://nhan.dev">nhan.dev</a>
      </h3>
      <p class="text-lg">Make the Web a better place</p>
    </div>
    <ul class="mt-6 flex items-center justify-end flex-wrap gap-4">
      <li>
        <a
          href="https://github.com/dnhn"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block"
        >
          <GitHubIcon aria-label="GitHub" class="size-11" />
        </a>
      </li>
      <li>
        <a
          href="https://linkedin.com/in/dnhn"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block"
        >
          <LinkedInIcon aria-label="LinkedIn" class="size-11" />
        </a>
      </li>
    </ul>
    <p class="mt-16 text-base">
      been fooling around since
      <a
        href="https://en.wikipedia.org/wiki/2008"
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold italic"
      >2008</a>.
    </p>
  </div>
</footer>
