---
import { Image } from 'astro:assets'
import NhanDev from '@/components/nhan-dev.astro'
import SloganCircle from '@/components/slogan-circle.svelte'
import AtSymbol from '@/components/icons/at-symbol.astro'
import GitHubIcon from '@/components/icons/github-icon.astro'
import LinkedInIcon from '@/components/icons/linkedin-icon.astro'
import SunRising from '@/components/icons/sun-rising.astro'
---

<footer class="min-h-svh">
  <div class="container py-16 md:py-24 lg:py-36">
    <button type="button" aria-label="The drawing" class="nhan-dev relative cursor-none">
      <NhanDev class="w-full h-auto aspect-[3.75]" />
      <span aria-hidden="true" class="indicator absolute top-0 left-0 size-[8vw] pointer-events-none transition-opacity md:size-16">
        <Image src="/sparkles.svg" width={79} height={76} alt="" class="size-full" />
      </span>
    </button>
    <div data-lag=".125" class="mt-20 items-end justify-between gap-6 md:mt-32 md:flex">
      <p class="text-xl md:max-w-[14ch] md:text-4xl/snug">
        Make the <a
          href="https://home.cern/science/computing/birth-web"
          target="_blank"
          rel="noopener noreferrer"
          class="underline-offset-2 max-lg:underline hover:underline"
        >Web</a> a better place
        <button type="button" aria-label="Shiny" onclick="playSunSound()" class="group sun inline align-middle size-8 text-yellow-400 md:size-12 dark:text-[yellow]">
          <SunRising class="size-full transition-[scale] group-active:scale-150" />
        </button>
      </p>
      <button type="button" onclick="playHeySound()" class="hey group relative inline-block text-xl cursor-grab max-md:mt-4 md:text-4xl">
        <span class="sr-only">Contact me:</span>
        <Image
          src="/raised-hand.svg"
          alt="Raised hand"
          width={64}
          height={64}
          aria-hidden="true"
          class="absolute bottom-0 max-md:left-full md:right-full ml-2 mr-1 opacity-0 size-8 transition-[opacity,rotate] origin-[40%_70%] md:size-12 lg:group-hover:opacity-100 lg:group-focus:opacity-100 lg:group-hover:-rotate-20 lg:group-focus:-rotate-20 group-active:opacity-100 group-active:-rotate-20"
        />hey<AtSymbol aria-label="at" class="inline size-5 md:size-8" />nhan.dev
      </button>
    </div>
    <div class="mt-30 justify-between items-end gap-8 md:mt-48 md:flex">
      <ul data-lag=".25" class="flex items-center flex-wrap gap-4 max-md:justify-end">
        <li class="size-11">
          <a
            href="https://github.com/dnhn"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block"
          >
            <GitHubIcon aria-label="GitHub" class="size-11" />
          </a>
        </li>
        <li class="size-11">
          <a
            href="https://linkedin.com/in/dnhn"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block"
          >
            <LinkedInIcon aria-label="LinkedIn" class="size-11" />
          </a>
        </li>
      </ul>
      <p data-lag=".5" class="text-sm max-md:mt-6 max-md:text-right md:text-lg">
        messing with the Web since <a
          href="https://en.wikipedia.org/wiki/2008"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold italic underline-offset-2 max-lg:underline hover:underline"
        >2008</a>.
      </p>
    </div>
  </div>
</footer>

<SloganCircle client:only="svelte" position={2} />
<SloganCircle client:only="svelte" position={3} />

<script>
import { gsap } from 'gsap'
import '@/scripts/gsap'

const footer = document.querySelector('footer') as HTMLElement
const nd = document.querySelector('.nhan-dev') as HTMLElement
const indicator = nd.querySelector('.indicator') as HTMLElement
const paths = nd.querySelectorAll('path')
const draw = gsap.timeline({
  defaults: { drawSVG: 0, ease: 'none' },
  scrollTrigger: {
    trigger: 'footer',
    start: 'top center',
  },
})
.from(paths[0], { duration: 3 })
.from(paths[1], { duration: .75 })
.from(paths[2], { duration: 1.25 })
const drawBlank = gsap.timeline({
  defaults: {
    drawSVG: '100% 100%',
    ease: 'none',
  },
  paused: true,
})
.to(paths[0], { duration: 1.5 })
.to(paths[1], { duration: .375 })
.to(paths[2], { duration: .625 })

gsap.set(indicator, {
  xPercent: -50,
  yPercent: -50,
  x: nd.getBoundingClientRect().width * .55,
  y: nd.getBoundingClientRect().height / 2,
})

nd.addEventListener('click', function () {
  if (draw.isActive() || drawBlank.isActive()) return
  if (draw.progress() === 1) {
    drawBlank.play(0).eventCallback('onComplete', function () {
      draw.restart()
    })
  }
})

function onMove(e: MouseEvent) {
  const { left, top } = nd.getBoundingClientRect()

  gsap.quickTo(indicator, 'x', { duration: .5, ease: 'circ' })(e.clientX - left)
  gsap.quickTo(indicator, 'y', { duration: .5, ease: 'circ' })(e.clientY - top)
}

nd.addEventListener('mouseenter', () => window.addEventListener('mousemove', onMove))
nd.addEventListener('mouseleave', function () {
  window.removeEventListener('mousemove', onMove)

  const { width, height } = nd.getBoundingClientRect()

  gsap.quickTo(indicator, 'x', { duration: 1, ease: 'elastic' })( width * .55)
  gsap.quickTo(indicator, 'y', { duration: 1, ease: 'elastic' })( height / 2)
})

window.addEventListener('resize', function () {
  const { width, height } = nd.getBoundingClientRect()

  gsap.set(indicator, { x: width * .55, y: height / 2 })
})
</script>

<script is:inline>
let heyAudio, sunAudio

function playHeySound() {
  if (!heyAudio) heyAudio = new Audio('/sounds/88401_950462-lq.mp3')
  heyAudio.currentTime = 0
  heyAudio.play()
}

function playSunSound() {
  if (!sunAudio) sunAudio = new Audio('/sounds/810183_17437502-lq.mp3')
  sunAudio.currentTime = 0
  sunAudio.play()
}
</script>
